# =============================================================================
# ValuSafe — Docker-Konfiguration
#
# 1. Diese Datei kopieren:   cp .env.example .env
# 2. Die mit AENDERN markierten Werte setzen
# 3. Starten:                docker compose up -d
#
# Die .env wird nicht ins Image kopiert (siehe .dockerignore) und gehoert
# nicht in die Versionsverwaltung.
# =============================================================================

# ── Datenbank ────────────────────────────────────────────────────────── AENDERN
# Zwei verschiedene Passwoerter. Sie werden beim ersten Start in die Datenbank
# eingetragen; eine spaetere Aenderung hier wirkt nicht mehr auf eine bereits
# angelegte Datenbank.
DB_NAME=valusafe
DB_USER=valusafe
DB_PASS=
DB_ROOT_PASS=

# ── Administratorkonto ───────────────────────────────────────────────── AENDERN
# Wird nur beim allerersten Start angelegt, und nur wenn noch kein Benutzer
# existiert. Der hier eingetragene Name wird zugleich als SUPERADMIN_USERNAME
# gesetzt — nur dieses Konto erreicht die Benutzerverwaltung im Backend.
ADMIN_USER=admin
#
# ADMIN_PASS leer lassen: der Container erzeugt beim ersten Start ein
# Zufallspasswort und zeigt es EINMALIG im Log an. Abrufen mit:
#     docker compose logs app
# Alternativ hier ein eigenes Passwort eintragen. Dann erscheint es nicht im
# Log — dafuer steht es im Klartext in dieser Datei.
ADMIN_PASS=

# ── Anwendung ────────────────────────────────────────────────────────────────
# Name dieser Instanz (erscheint im Kopfbereich der Anwendung)
APP_NAME=ValuSafe

# Port, unter dem die Anwendung lokal erreichbar ist
APP_PORT=8080

# ── Backup-Token (optional) ──────────────────────────────────────────────────
# Schuetzt cron_backup.php, also den vollstaendigen Datenbank-Export.
# Leer lassen ist der empfohlene Weg: der Container erzeugt beim ersten Start
# einen zufaelligen Token und legt ihn unter backups/.backup_token ab, wo er
# Neustarts uebersteht. Nur setzen, wenn der Token von aussen vorgegeben sein
# muss — etwa weil ein Cron-Dienst ihn bereits kennt.
BACKUP_TOKEN=

# ── phpMyAdmin (nur fuer Entwicklung) ────────────────────────────────────────
# Startet nur mit:  docker compose --profile dev up -d
# In Produktion nicht verwenden.
PMA_PORT=8081
